{
  "name": "dinnerdatewithdeath",
  "version": "0.0.6.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "assets:death": "tsx tools/assets/process-death.ts",
    "assets:mansion-architecture": "tsx tools/assets/process-mansion-architecture.ts",
    "assets": "tsx tools/assets/build-all-assets.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "assets:environment:all": "tsx tools/assets/build-pack-atlases.ts && tsx tools/assets/build-compiled-catalog.ts"
  },
  "dependencies": {
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/sharp": "^0.31.1",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}